+static void np545_pcie0_report(struct qmp_pcie *qmp, unsigned int val,
+			       unsigned int mask, int ret)
+{
+	int i;
+
+	dev_info(qmp->dev, "PCIe0 x1 PHY+%#x status=%#x mask=%#x power_on=%d\n",
+		 qmp->cfg->offsets->pcs + qmp->cfg->regs[QPHY_PCS_STATUS],
+		 val, mask, ret);
+	for (i = 0; i < ARRAY_SIZE(qmp_pciephy_clk_l); i++)
+		if (qmp->clks[i].clk)
+			dev_info(qmp->dev, "clock %s CCF rate=%lu\n",
+				 qmp->clks[i].id, clk_get_rate(qmp->clks[i].clk));
+	for (i = 0; i < qmp->num_pipe_clks; i++)
+		if (qmp->pipe_clks[i].clk)
+			dev_info(qmp->dev, "clock %s CCF rate=%lu\n",
+				 qmp->pipe_clks[i].id, clk_get_rate(qmp->pipe_clks[i].clk));
+	for (i = 0; i < qmp->cfg->num_vregs; i++)
+		dev_info(qmp->dev, "supply %s enabled=%d uV=%d\n",
+			 qmp->vregs[i].supply, regulator_is_enabled(qmp->vregs[i].consumer),
+			 regulator_get_voltage(qmp->vregs[i].consumer));
+}
