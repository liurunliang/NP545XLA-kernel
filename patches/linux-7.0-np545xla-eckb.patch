+/* Manual opt-in also accepts the older daily DT with the verified IRQ. */
+static bool existing_dt;
+module_param(existing_dt, bool, 0444);
+MODULE_PARM_DESC(existing_dt, "Allow the NP545XLA daily keyboard DT without its specific compatible");
+
+static bool np545_eckb_matches(struct i2c_client *client)
+{
+	struct device_node *node = client->dev.of_node;
+	struct device_node *keyboard;
+	struct of_phandle_args irq;
+	bool matches;
+
+	if (!of_machine_is_compatible("samsung,np545xla") || !node ||
+	    client->addr != 0x05)
+		return false;
+	if (!of_device_is_compatible(node, "samsung,np545xla-eckb") &&
+	    !(existing_dt && of_device_is_compatible(node, "hid-over-i2c")))
+		return false;
+
+	keyboard = of_find_node_by_path("/soc@0/geniqup@ac0000/i2c@a80000/keyboard@5");
+	matches = keyboard == node;
+	of_node_put(keyboard);
+	if (!matches || of_irq_parse_one(node, 0, &irq))
+		return false;
+
+	matches = of_device_is_compatible(irq.np, "qcom,sc8180x-tlmm") &&
+		  irq.args_count == 2 && irq.args[0] == 125 &&
+		  irq.args[1] == IRQ_TYPE_LEVEL_LOW;
+	of_node_put(irq.np);
+	return matches;
+}
+
