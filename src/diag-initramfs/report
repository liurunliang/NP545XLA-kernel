#!/bin/sh
# Generate a full snapshot on demand. A rename keeps SSH reads consistent.
set -u
out=/run/diagnostics
snapshot="$out/dmesg.$$"
trap 'rm -f "$snapshot"' EXIT
dmesg > "$snapshot" 2>&1
{
    cat "$out/status"
    echo
    echo '--- Kernel and firmware ---'
    uname -a
    cat /proc/cmdline
    [ ! -r /sys/firmware/devicetree/base/compatible ] || tr '\000' '\n' < /sys/firmware/devicetree/base/compatible
    ls /sys/firmware/acpi/tables 2>/dev/null
    echo
    echo '--- Framebuffers and native display module results ---'
    cat /proc/fb
    if [ -f "$out/display-modules.log" ]; then
        cat "$out/display-modules.log"
    else
        echo 'Native display modules: not requested'
    fi
    echo '--- USB devices: topology, ID, product, driver ---'
    for usb in /sys/bus/usb/devices/*; do
        [ -r "$usb/idVendor" ] || continue
        printf '%s %s:%s %s\n' "${usb##*/}" "$(cat "$usb/idVendor")" "$(cat "$usb/idProduct")" "$(cat "$usb/product" 2>/dev/null)"
        for interface in "$usb":*; do
            [ -L "$interface/driver" ] || continue
            printf '  %s -> %s\n' "${interface##*/}" "$(readlink "$interface/driver")"
        done
    done
    echo '--- Block devices: major, minor, size (KiB), name ---'
    cat /proc/partitions
    echo '--- Mounts ---'
    cat /proc/mounts
    echo '--- Input ---'
    cat /proc/bus/input/devices 2>/dev/null
    echo '--- Interfaces and routes ---'
    ip addr
    ip route
    echo '--- Deferred probes ---'
    cat /sys/kernel/debug/devices_deferred 2>/dev/null
    echo '--- DHCP and SSH ---'
    for logfile in "$out"/dhcp.log "$out"/ssh.log; do
        [ ! -f "$logfile" ] || tail -50 "$logfile"
    done
    echo '--- I2C HID incomplete reports (current kernel ring only) ---'
    awk '
        /i2c_hid_get_input: incomplete report/ && match($0, /^\[[[:space:]]*[0-9]+\.[0-9]+\]/) {
            stamp = substr($0, 2, RLENGTH - 2) + 0
            device = substr($0, RLENGTH + 1)
            sub(/^[[:space:]]+/, "", device)
            sub(/: i2c_hid_get_input:.*/, "", device)
            if (!(device in count)) first[device] = stamp
            last[device] = stamp
            count[device]++
            total++
        }
        END {
            if (!total) print "No matching records"
            for (device in count) {
                span = last[device] - first[device]
                printf "%s: %d records, first %.6f s, last %.6f s", device, count[device], first[device], last[device]
                if (span > 0) printf ", %.1f records/s", (count[device] - 1) / span
                print ""
            }
        }
    ' "$snapshot"
    echo '--- I2C HID IRQ counters (since boot, currently registered) ---'
    grep -Ei 'hid[-_]over[-_]i2c|i2c[-_]hid' /proc/interrupts || echo 'No matching IRQ counters'
    echo '--- Early kernel messages (saved once at /init) ---'
    cat "$out/boot-dmesg.txt"
    echo '--- Kernel messages (current ring) ---'
    cat "$snapshot"
} > "$out/report.$$" 2>&1
mv "$out/report.$$" "$out/report.txt"
