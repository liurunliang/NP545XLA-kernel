#!/bin/bash
# Run as root on the persistent Debian system from the complete desktop directory.
set -euo pipefail
export LC_ALL=C
cd "$(dirname "$0")"
[[ $EUID == 0 && $(dpkg --print-architecture) == arm64 ]] || { echo 'Run as root on Debian arm64.' >&2; exit 1; }
[[ -f /etc/systemd/network/20-np545xla-wired.network && -f prepare-xorg && -f greeter-osk.conf ]] || { echo 'Expected the NP545XLA Debian image and desktop helpers.' >&2; exit 1; }
systemctl is-active --quiet systemd-networkd.service
systemctl is-active --quiet ssh.service
passwd -S liurunliang

# If a site already moved the SSH uplink to NetworkManager, leave its live
# connection alone. The shipped image owns all wired interfaces via networkd.
if systemctl is-active --quiet NetworkManager.service &&
   nmcli -t -f TYPE,STATE device | grep -Eq '^ethernet:connected$'; then
    echo 'An Ethernet connection is already managed by NetworkManager. Keep the current SSH uplink and inspect nmcli device first.' >&2
    exit 1
fi
install -d /etc/NetworkManager/conf.d /etc/lightdm/lightdm.conf.d \
    /etc/systemd/system/lightdm.service.d /etc/X11/Xsession.d /usr/local/libexec
cat > /etc/NetworkManager/conf.d/90-np545xla-wifi.conf <<'CONF'
[main]
dns=systemd-resolved
rc-manager=unmanaged

[keyfile]
unmanaged-devices=*,except:type:wifi

[connection-np545xla-wifi]
match-device=type:wifi
ipv4.route-metric=3000
ipv6.route-metric=3000
CONF
install -m 0755 prepare-xorg /usr/local/libexec/np545xla-prepare-xorg
install -Dm 0644 greeter-osk.conf /etc/lightdm/lightdm-gtk-greeter.conf.d/90-np545xla-onscreen-keyboard.conf
cat > /etc/lightdm/lightdm.conf.d/90-np545xla.conf <<'CONF'
[Seat:*]
greeter-session=lightdm-gtk-greeter
greeter-show-manual-login=true
allow-guest=false
user-session=xfce
xserver-command=X -core -config /run/np545xla-desktop/xorg.conf
CONF
cat > /etc/systemd/system/lightdm.service.d/90-np545xla.conf <<'UNIT'
[Unit]
Wants=np545xla-display.service
After=np545xla-display.service

[Service]
ExecStartPre=/usr/local/libexec/np545xla-prepare-xorg
UNIT
cat > /etc/X11/Xsession.d/80np545xla-render <<'SESSION'
if [ -f /run/np545xla-desktop/software-render ]; then
    export LIBGL_ALWAYS_SOFTWARE=1
fi
SESSION

systemctl daemon-reload
if systemctl is-active --quiet NetworkManager.service; then nmcli general reload conf; fi
export DEBIAN_FRONTEND=noninteractive
apt-get update --error-on=any
apt-get install -y --no-install-recommends \
    xfce4 xfce4-terminal lightdm lightdm-gtk-greeter xserver-xorg-core \
    xserver-xorg-input-libinput libinput-tools xinput x11-xserver-utils x11-utils mesa-utils \
    libgl1-mesa-dri firefox-esr fonts-noto-cjk network-manager network-manager-gnome \
    wpasupplicant dbus-user-session libpam-systemd \
    onboard gsettings-desktop-schemas gir1.2-atspi-2.0 at-spi2-core
systemctl enable --now NetworkManager.service
systemctl disable NetworkManager-wait-online.service
systemctl enable lightdm.service
systemctl set-default graphical.target
systemctl start lightdm.service
for unit in ssh systemd-networkd NetworkManager lightdm; do
    systemctl is-active --quiet "$unit.service" || { echo "$unit is not active." >&2; exit 1; }
done
nmcli -f DEVICE,TYPE,STATE device
status=$(passwd -S liurunliang | cut -d' ' -f2)
if [[ $status != P ]]; then
    echo 'Set a local login password in your existing trusted SSH terminal: sudo passwd liurunliang'
fi
